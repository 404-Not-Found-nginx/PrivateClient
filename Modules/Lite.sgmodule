#!name=YZTC 分流模块（GeoSite 精简版）
#!desc=仿照 YZTC.yaml 规格与内容生成的分流模块（无节点信息，通用规则使用 PopCat 官方支持的 GeoSite / GeoIP 精简替换）。

[General]
# 直连域名使用的 DNS 解析器
dns-server = 223.5.5.5, 119.29.29.29, https://223.5.5.5/dns-query, https://doh.pub/dns-query

[Host]
# 连通性检测与 NTP 域名使用系统 DNS 解析真实 IP，不分配虚拟 IP
+.msftconnecttest.com = server:system
+.msftncsi.com = server:system
+.msftncsi.com.cn = server:system
captive.apple.com = server:system
connectivitycheck.gstatic.com = server:system
detectportal.firefox.com = server:system
+.pool.ntp.org = server:system
+.time.edu.cn = server:system

[Proxy Group]
# 地区节点分组（手动选择，按正则筛选订阅节点）
🇭🇰 香港节点 = select, policy-regex-filter=(?i)(香港|hong ?kong|\bhk\b|🇭🇰)
🇲🇴 澳门节点 = select, policy-regex-filter=(?i)(澳门|macao|macau|\bmo\b|🇲🇴)
🇯🇵 日本节点 = select, policy-regex-filter=(?i)(日本|japan|\bjp\b|🇯🇵)
🇺🇸 美国节点 = select, policy-regex-filter=(?i)(美国|united ?states|\busa?\b|🇺🇸)
🇹🇼 台湾节点 = select, policy-regex-filter=(?i)(台湾|taiwan|\btw\b|🇹🇼)
🇸🇬 狮城节点 = select, policy-regex-filter=(?i)(新加坡|狮城|singapore|\bsg\b|🇸🇬)
🇰🇷 韩国节点 = select, policy-regex-filter=(?i)(韩国|korea|\bkr\b|🇰🇷)
🇮🇳 印度节点 = select, policy-regex-filter=(?i)(印度|india|\bin\b|🇮🇳), exclude-regex=(?i)(印度尼西亚|indonesia)
🇺🇦 乌克兰节点 = select, policy-regex-filter=(?i)(乌克兰|ukraine|\bua\b|🇺🇦)
🇷🇺 俄罗斯节点 = select, policy-regex-filter=(?i)(俄罗斯|russia|\bru\b|🇷🇺)
🇹🇷 土耳其节点 = select, policy-regex-filter=(?i)(土耳其|turkey|\btr\b|🇹🇷)
🇦🇷 阿根廷节点 = select, policy-regex-filter=(?i)(阿根廷|argentina|\bar\b|🇦🇷)

# 功能策略分组
Emby影视服 = select, 🇭🇰 香港节点, 🇲🇴 澳门节点, 🇹🇼 台湾节点, 🇸🇬 狮城节点, 🇯🇵 日本节点, policy-regex-filter=(?i)emby
ONE NZ = select, include-all-proxies=true
Ultra = select, 🇺🇸 美国节点, include-all-proxies=true
📲 电报消息 = select, DIRECT, include-all-proxies=true
💬 Ai平台 = select, 🇺🇸 美国节点, DIRECT, include-all-proxies=true
📢 谷歌 = select, DIRECT, include-all-proxies=true
Google Voice = select, 🇺🇸 美国节点
📹 油管视频 = select, 🇸🇬 狮城节点, 🇭🇰 香港节点, 🇹🇼 台湾节点, 🇯🇵 日本节点, 🇺🇸 美国节点, 🇰🇷 韩国节点, 🇮🇳 印度节点, 🇺🇦 乌克兰节点, 🇷🇺 俄罗斯节点, 🇹🇷 土耳其节点, 🇦🇷 阿根廷节点, DIRECT, include-all-proxies=true
Ⓜ️ 微软 = select, DIRECT, include-all-proxies=true
Ⓜ️ OneDrive = select, DIRECT, include-all-proxies=true
📺 哔哩哔哩 = select, DIRECT, include-all-proxies=true
🔮 IP归属地 = select, DIRECT, include-all-proxies=true
🍎 苹果服务 = select, DIRECT, 🇺🇸 美国节点, include-all-proxies=true
WeChat = select, DIRECT, 🇸🇬 狮城节点
闲鱼 = select, DIRECT, include-all-proxies=true
🎮 游戏平台 = select, DIRECT, 🇺🇸 美国节点, 🇮🇳 印度节点, 🇺🇦 乌克兰节点, 🇷🇺 俄罗斯节点, 🇹🇷 土耳其节点, 🇦🇷 阿根廷节点, include-all-proxies=true
🌍 国外媒体 = select, 🇭🇰 香港节点, 🇹🇼 台湾节点, 🇸🇬 狮城节点, 🇯🇵 日本节点, 🇺🇸 美国节点, 🇰🇷 韩国节点, 🇮🇳 印度节点, 🇺🇦 乌克兰节点, 🇷🇺 俄罗斯节点, 🇹🇷 土耳其节点, 🇦🇷 阿根廷节点, DIRECT, include-all-proxies=true
🎯 全球直连 = select, DIRECT, include-all-proxies=true
🌏 国内媒体 = select, DIRECT, 🇭🇰 香港节点, 🇲🇴 澳门节点, 🇹🇼 台湾节点, include-all-proxies=true
🎥 奈飞视频 = select, 🇸🇬 狮城节点, 🇭🇰 香港节点, 🇹🇼 台湾节点, 🇯🇵 日本节点, 🇺🇸 美国节点, 🇰🇷 韩国节点, 🇮🇳 印度节点, 🇺🇦 乌克兰节点, 🇷🇺 俄罗斯节点, 🇹🇷 土耳其节点, 🇦🇷 阿根廷节点, DIRECT, include-all-proxies=true
🐟 漏网之鱼 = select, 🇭🇰 香港节点, 🇹🇼 台湾节点, 🇸🇬 狮城节点, 🇯🇵 日本节点, 🇺🇸 美国节点, 🇰🇷 韩国节点, 🇮🇳 印度节点, 🇺🇦 乌克兰节点, 🇷🇺 俄罗斯节点, 🇹🇷 土耳其节点, 🇦🇷 阿根廷节点, DIRECT, include-all-proxies=true

